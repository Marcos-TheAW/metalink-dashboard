---
import Layout from '../../../layouts/Layout.astro';
import BotaoExcluir from '../../../components/BotaoExcluir.astro';
import KpiCard from '../../../components/KpiCard.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { listSemanasSitesProspectados, listSitesProspectados } from '../../../lib/db';
import {
  CANAIS_PROSPECCAO,
  STATUS_PROSPECCAO,
  formatarDataBR,
  labelFor,
  numeroOuTraco,
  percentualOuTraco
} from '../../../lib/types';

const usuario = Astro.locals.usuario;
const url = Astro.url;

const status = url.searchParams.get('status') ?? '';
const canal = url.searchParams.get('canal') ?? '';
const nicho = url.searchParams.get('nicho') ?? '';
const semana = url.searchParams.get('semana') ?? '';
const registroInicio = url.searchParams.get('registro_inicio') ?? '';
const registroFim = url.searchParams.get('registro_fim') ?? '';

const [sites, semanas] = await Promise.all([
  listSitesProspectados({
    status: status || undefined,
    canal: canal || undefined,
    nicho: nicho || undefined,
    semana: semana || undefined,
    registroInicio: registroInicio || undefined,
    registroFim: registroFim || undefined
  }),
  listSemanasSitesProspectados()
]);

const totalSites = sites.length;
const totalFechados = sites.filter((s) => s.status === 'fechado').length;
const totalAguardando = sites.filter((s) => s.status === 'contatado_aguardando_resposta').length;
const respondentes = totalSites - totalAguardando;
const taxaResposta = totalSites > 0 ? respondentes / totalSites : null;
---

<Layout title="Registro de Sites" usuario={usuario}>
  <div class="mb-6 flex items-center justify-between">
    <h1>Registro de Sites</h1>
    <a href="/prospeccao/sites/novo" class="btn-primary">Novo site prospectado</a>
  </div>

  <form method="get" class="card mb-6 flex flex-col gap-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div>
        <label for="semana">Semana (segunda)</label>
        <select id="semana" name="semana">
          <option value="">Todas</option>
          {semanas.map((s) => <option value={s} selected={s === semana}>{formatarDataBR(s)}</option>)}
        </select>
      </div>
      <div class="sm:col-span-2">
        <label>Data do Registro</label>
        <div class="mt-1 flex items-center gap-2">
          <input type="date" name="registro_inicio" value={registroInicio} class="mt-0 w-full min-w-0" />
          <span class="shrink-0 text-slate-500">–</span>
          <input type="date" name="registro_fim" value={registroFim} class="mt-0 w-full min-w-0" />
        </div>
      </div>
      <div>
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="">Todos</option>
          {STATUS_PROSPECCAO.map((s) => <option value={s.value} selected={s.value === status}>{s.label}</option>)}
        </select>
      </div>
      <div>
        <label for="canal">Canal</label>
        <select id="canal" name="canal">
          <option value="">Todos</option>
          {CANAIS_PROSPECCAO.map((c) => <option value={c.value} selected={c.value === canal}>{c.label}</option>)}
        </select>
      </div>
      <div>
        <label for="nicho">Nicho</label>
        <input type="text" id="nicho" name="nicho" value={nicho} placeholder="Ex: finanças" />
      </div>
    </div>

    <div class="flex gap-3">
      <button type="submit" class="btn-primary">Filtrar</button>
      <a href="/prospeccao/sites" class="btn-secondary">Limpar filtros</a>
    </div>
  </form>

  <section class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <KpiCard label="Sites (filtro atual)" value={numeroOuTraco(totalSites)} />
    <KpiCard label="Fechados (filtro atual)" value={numeroOuTraco(totalFechados)} />
    <KpiCard label="Taxa de resposta (filtro atual)" value={percentualOuTraco(taxaResposta)} />
  </section>

  <div class="card overflow-x-auto max-h-[70vh] overflow-y-auto pt-0">
    <table>
      <thead>
        <tr>
          <th>Semana</th>
          <th>Site</th>
          <th>DR</th>
          <th>Nicho</th>
          <th>Canal</th>
          <th>Tentativas</th>
          <th>Status</th>
          <th>Data do Registro</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        {
          sites.map((s) => (
            <tr>
              <td>{formatarDataBR(s.data_contato)}</td>
              <td>
                <a href={`/prospeccao/sites/${s.id}`} class="font-medium text-brand-600 hover:underline">
                  {s.url_site}
                </a>
              </td>
              <td>{numeroOuTraco(s.domain_rating)}</td>
              <td>{s.nicho ?? '—'}</td>
              <td>{labelFor(CANAIS_PROSPECCAO, s.canal)}</td>
              <td>{s.num_tentativas}</td>
              <td>
                <StatusBadge value={s.status} label={labelFor(STATUS_PROSPECCAO, s.status)} />
              </td>
              <td>{formatarDataBR(s.criado_em)}</td>
              <td class="overflow-visible">
                <details class="relative">
                  <summary
                    class="cursor-pointer list-none rounded px-1.5 py-0.5 leading-none text-slate-400 hover:bg-slate-200 hover:text-white [&::-webkit-details-marker]:hidden"
                    aria-label="Ações do site"
                  >
                    ⋮
                  </summary>
                  <div class="absolute right-0 z-10 mt-1 w-36 rounded-md border border-slate-300 bg-slate-100 py-1 shadow-lg">
                    <a href={`/prospeccao/sites/${s.id}`} class="block px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-200 hover:text-white">
                      Editar
                    </a>
                    <div class="px-3 py-1.5">
                      <BotaoExcluir
                        action={`/api/prospeccao/sites/${s.id}/excluir`}
                        mensagemConfirmacao={`Atenção: esta ação é irreversível. Tem certeza que deseja excluir o site ${s.url_site}? Todos os dados desse registro serão perdidos permanentemente.`}
                        compacto
                      />
                    </div>
                  </div>
                </details>
              </td>
            </tr>
          ))
        }
        {sites.length === 0 && (
          <tr>
            <td colspan="9" class="text-center text-slate-400">Nenhum site prospectado encontrado para esses filtros.</td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</Layout>
